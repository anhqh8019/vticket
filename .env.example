# Copy to .env and replace every password before starting.
SQLSERVER_SA_PASSWORD=
ADMIN_PASSWORD=
STAFF_PASSWORD=
WEB_PORT=8088
# Local SQL Server Developer testing only. For production use a dedicated DB login.
APP_SEED_DATA=true

# VietQR: separate outbound API credentials from inbound callback credentials.
VIETQR_ENABLED=false
VIETQR_API_BASE_URL=https://dev.vietqr.org
VIETQR_API_USERNAME=
VIETQR_API_PASSWORD=
VIETQR_BANK_CODE=MB
VIETQR_BANK_ACCOUNT=
VIETQR_BANK_ACCOUNT_NAME=
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_JWT_SECRET=
VIETQR_CALLBACK_TOKEN_EXPIRATION_SECONDS=300

# Smile Onsen: a separate SQL Server connection. Never point Flyway at this database.
SMILE_ENABLED=false
SMILE_DB_URL=
SMILE_DB_USERNAME=
SMILE_DB_PASSWORD=
SMILE_SCHEMA=dbo
SMILE_TABLE=TicketOnsen
SMILE_CLERK_ID=
SMILE_CODE_MAPPING=FIELD_NAMES
SMILE_WORKER_ENABLED=true
